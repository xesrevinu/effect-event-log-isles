{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/router.tsx",
    "src/routes/**/*.{ts,tsx}",
    "src/components/workshop.tsx",
    "scripts/png-sequence.test.mjs",
    "scripts/i18n-locale.test.mjs"
  ],
  "project": [
    "src/components/**/*.{ts,tsx}",
    "src/lib/**/*.{ts,tsx}",
    "src/routes/**/*.{ts,tsx}",
    "src/router.tsx",
    "scripts/png-sequence.test.mjs",
    "scripts/i18n-locale.test.mjs",
    "!src/lib/auth/**",
    "!src/lib/db.ts",
    "!src/lib/multiplayer/**",
    "!src/lib/preview-host-bridge.ts",
    "!src/lib/internal/**",
    "!src/components/preview-host-bridge.tsx",
    "!src/routeTree.gen.ts"
  ],
  "ignore": [
    ".grok/**",
    ".vercel/**",
    ".output/**",
    ".nitro/**",
    "dist/**",
    "vendor/**",
    "attachments/**",
    "screenshots/**",
    "grok-final-pets-resources/**",
    "public/**",
    "server/**",
    "scripts/brand-check*",
    "scripts/browser-*",
    "scripts/grok-*",
    "scripts/install-page.html",
    "scripts/migrate.mjs",
    "scripts/pet-matte*",
    "scripts/preview-thumbnail.mjs",
    "scripts/qa-isle-heights.mjs",
    "scripts/recut-pets.mjs",
    "scripts/restore-styles.py",
    "src/lib/auth/**",
    "src/lib/db.ts",
    "src/lib/multiplayer/**",
    "src/lib/preview-host-bridge.ts",
    "src/lib/internal/**",
    "src/components/preview-host-bridge.tsx",
    "src/routeTree.gen.ts"
  ],
  "ignoreDependencies": [
    "@electric-sql/pglite",
    "@hookform/resolvers",
    "@radix-ui/react-accordion",
    "@radix-ui/react-alert-dialog",
    "@radix-ui/react-avatar",
    "@radix-ui/react-checkbox",
    "@radix-ui/react-collapsible",
    "@radix-ui/react-dialog",
    "@radix-ui/react-dropdown-menu",
    "@radix-ui/react-label",
    "@radix-ui/react-popover",
    "@radix-ui/react-progress",
    "@radix-ui/react-radio-group",
    "@radix-ui/react-scroll-area",
    "@radix-ui/react-select",
    "@radix-ui/react-separator",
    "@radix-ui/react-slider",
    "@radix-ui/react-slot",
    "@radix-ui/react-switch",
    "@radix-ui/react-tabs",
    "@radix-ui/react-toggle",
    "@radix-ui/react-toggle-group",
    "@radix-ui/react-tooltip",
    "@tanstack/react-query",
    "@tanstack/react-table",
    "@tanstack/router-plugin",
    "better-auth",
    "class-variance-authority",
    "cmdk",
    "date-fns",
    "kysely",
    "lightningcss",
    "pg",
    "react-day-picker",
    "react-hook-form",
    "react-resizable-panels",
    "recharts",
    "sonner",
    "tailwindcss",
    "tw-animate-css",
    "vaul",
    "zod",
    "zustand"
  ],
  "ignoreExportsUsedInFile": {
    "type": true,
    "interface": true
  },
  "includeEntryExports": false
}
